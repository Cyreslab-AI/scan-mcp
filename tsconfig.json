{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@analyzer/*": ["src/analyzer/*"],
      "@scanners/*": ["src/scanners/*"],
      "@vulnerabilities/*": ["src/vulnerabilities/*"],
      "@mcp-server/*": ["src/mcp-server/*"],
      "@sandbox/*": ["src/sandbox/*"],
      "@database/*": ["src/database/*"],
      "@reports/*": ["src/reports/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
